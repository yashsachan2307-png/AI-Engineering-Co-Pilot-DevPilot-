# DevPilot Environment Configuration (Example)
# Copy this file to .env and fill in the actual values

# ---------------------------------------------------------
# FRONTEND CONFIGURATION
# ---------------------------------------------------------
# The URL where the frontend expects the backend API to reside.
# Local Development: http://localhost:8080
# Production: https://devpilot-backend.onrender.com (or your Render URL)
VITE_API_URL=http://localhost:8080

# ---------------------------------------------------------
# BACKEND CONFIGURATION
# ---------------------------------------------------------
# The URL of the frontend application (used by Spring Boot for CORS configuration)
# Local Development: http://localhost:5173
# Production: https://devpilot-frontend.vercel.app (or your Vercel URL)
FRONTEND_URL=http://localhost:5173

# Port the backend server listens on
# Local Development: 8080
# Production (Render): This will be automatically injected by Render using the PORT variable
PORT=8080

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# Database URL, Username, and Password for PostgreSQL
# Local Development: leave blank to use in-memory H2 database
# Production (Neon): jdbc:postgresql://<neon-host>:5432/<neon-db>?sslmode=require
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# (Optional) Explicitly define the Postgres Driver & Dialect if not auto-detected
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ---------------------------------------------------------
# AUTHENTICATION (JWT & ENCRYPTION)
# ---------------------------------------------------------
# Secret key used to sign JWT tokens. Must be a secure, random string (e.g. 256-bit hex)
JWT_SECRET=your_jwt_secret_here

# Secret key used for encryption (Must be exactly 32 bytes for AES-256)
ENCRYPTION_KEY=12345678901234567890123456789012

# ---------------------------------------------------------
# GITHUB OAUTH
# ---------------------------------------------------------
# GitHub OAuth App Client ID and Secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Ensure this matches your GitHub OAuth App's Authorization callback URL
# Local: http://localhost:5173/github/callback
# Prod: https://your-vercel-url.vercel.app/github/callback
GITHUB_REDIRECT_URI=http://localhost:5173/github/callback

# ---------------------------------------------------------
# AI / LLM INTEGRATION
# ---------------------------------------------------------
# Your Gemini (or chosen LLM provider) API Key
AI_API_KEY=your_gemini_api_key_here
